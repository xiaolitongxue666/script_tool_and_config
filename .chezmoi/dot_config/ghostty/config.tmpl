# Ghostty 终端配置（macOS，由 chezmoi 管理）
# 参考: https://ghostty.org/docs/config
# 使用 zsh 作为 shell，与 run_once_install-zsh 一致

# 使用 zsh：优先级
#   1) 用户在 ~/.config/chezmoi/chezmoi.toml.local 的 [data] 里覆盖 macos_zsh_path
#   2) 运行时探测 command -v zsh（与交互 shell 一致，Intel 多为 /usr/local/bin/zsh）
#   3) 按架构回退到 Homebrew 默认路径
# 说明：曾硬编码 macos_zsh_path=/opt/homebrew/bin/zsh，导致 Intel 机渲染出错误路径，
#       只能靠 run_onchange sync 脚本 sed 纠正 —— 而 sed 回写受管文件会造成永久 drift。
{{- $zsh := "" -}}
{{- if index . "macos_zsh_path" -}}
{{- $zsh = index . "macos_zsh_path" -}}
{{- else -}}
{{- $zsh = output "sh" "-c" "command -v zsh 2>/dev/null || { [ -x /opt/homebrew/bin/zsh ] && echo /opt/homebrew/bin/zsh; } || echo /usr/local/bin/zsh" | trim -}}
{{- end -}}
command = {{ $zsh }}

# 显式启用 zsh 集成（工作目录继承、提示标记等）
shell-integration = zsh

# 使用 xterm-256color 以兼容 SSH 与远程 tmux（远程通常无 xterm-ghostty terminfo）
term = xterm-256color

# 外观：与 iTerm2 默认一致（纯黑底、浅色字、不透明、无模糊）
background = #000000
foreground = #c0c0c0
background-opacity = 1.0
background-blur = false
cursor-color = #c0c0c0
