{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
#!/bin/bash

# ============================================
# 通用工具安装（chezmoi run_once_）
# 包名 SSOT：scripts/chezmoi/packages.conf（经 software_policies.sh）
# ============================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${CHEZMOI_PROJECT_ROOT:-$(cd "${SCRIPT_DIR}/../.." && pwd 2>/dev/null || echo "$HOME")}"
COMMON_INSTALL="${PROJECT_ROOT}/scripts/chezmoi/common_install.sh"
if [ ! -f "$COMMON_INSTALL" ]; then
    COMMON_INSTALL="$HOME/.local/share/chezmoi/scripts/chezmoi/common_install.sh"
fi
if [ -f "$COMMON_INSTALL" ]; then
    # shellcheck disable=SC1090
    source "$COMMON_INSTALL"
else
    echo "[ERROR] common_install.sh not found" >&2
    exit 1
fi

export PROXY="${PROXY:-{{ env "http_proxy" | default "http://127.0.0.1:7890" }}}"
load_run_once_context "$SCRIPT_DIR" "install-common-tools" || exit 1

SOFTWARE_POLICIES="${PROJECT_ROOT}/scripts/chezmoi/software_policies.sh"
if [ -f "$SOFTWARE_POLICIES" ]; then
    # shellcheck disable=SC1090
    source "$SOFTWARE_POLICIES"
else
    echo "[ERROR] software_policies.sh not found" >&2
    exit 1
fi

IS_WSL=0
if [[ "$PLATFORM" == "linux" ]]; then
    if grep -qEi "Microsoft|WSL" /proc/version 2>/dev/null || [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
        IS_WSL=1
    fi
fi

if [[ "$PLATFORM" == "darwin" || "$PLATFORM" == "macos" ]]; then
    echo "[INFO] Environment: macOS (brew)"
elif [[ "$PLATFORM" == "windows" ]]; then
    echo "[INFO] Environment: Windows ($PACKAGE_MANAGER)"
elif [[ "$PLATFORM" == "linux" ]]; then
    if [[ "$IS_WSL" -eq 1 ]]; then
        echo "[INFO] Environment: Linux (WSL, $PACKAGE_MANAGER)"
    else
        echo "[INFO] Environment: Linux (native, $PACKAGE_MANAGER)"
    fi
fi

echo "[INFO] Installing common tools (packages.conf SSOT)..."

install_fastfetch_apt() {
    if command -v fastfetch &> /dev/null; then
        return 0
    fi
    echo "[INFO] Trying fastfetch install (apt/PPA/snap/.deb fallbacks)..."
    if sudo apt-get install -y fastfetch 2>/dev/null; then
        return 0
    fi
    if command -v add-apt-repository &> /dev/null; then
        echo "[INFO] Installing fastfetch via PPA..."
        if sudo add-apt-repository -y ppa:zhangsongcui3371/fastfetch 2>/dev/null && \
           sudo apt-get update -qq && sudo apt-get install -y fastfetch 2>/dev/null; then
            return 0
        fi
    fi
    if command -v snap &> /dev/null; then
        echo "[INFO] Installing fastfetch via Snap..."
        if sudo snap install fastfetch 2>/dev/null; then
            return 0
        fi
    fi
    local deb_url deb_file
    deb_url="$(curl -sL https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest | grep "browser_download_url" | grep "linux-amd64.deb" | head -1 | sed 's/.*"browser_download_url": "\([^"]*\)".*/\1/')"
    if [[ -n "$deb_url" ]]; then
        deb_file="/tmp/fastfetch-linux-amd64.$$.deb"
        echo "[INFO] Downloading fastfetch .deb from GitHub Releases..."
        if (command -v wget &>/dev/null && wget -q -O "$deb_file" "$deb_url") || (command -v curl &>/dev/null && curl -sL -o "$deb_file" "$deb_url"); then
            if sudo apt-get install -y "$deb_file" 2>/dev/null || sudo dpkg -i "$deb_file" 2>/dev/null; then
                rm -f "$deb_file"
                return 0
            fi
            rm -f "$deb_file"
        fi
    fi
    return 1
}

INSTALLED=0
FAILED=0
SKIPPED=0

if ! type get_common_tool_commands &>/dev/null || ! type get_common_tool_package &>/dev/null; then
    echo "[ERROR] get_common_tool_* helpers unavailable; aborting common-tools install"
    exit 1
fi

for tool in $(get_common_tool_commands); do
    pkg="$(get_common_tool_package "$tool" "${PLATFORM}" "${PACKAGE_MANAGER}")"

    if type common_tool_command_present &>/dev/null && common_tool_command_present "$tool"; then
        if command -v "$tool" &>/dev/null; then
            echo "[INFO] $tool already installed: $(command -v "$tool")"
        elif [[ "$tool" == "bat" ]] && command -v batcat &>/dev/null; then
            echo "[INFO] $tool already installed: $(command -v batcat) (batcat)"
        elif [[ "$tool" == "fd" ]] && command -v fdfind &>/dev/null; then
            echo "[INFO] $tool already installed: $(command -v fdfind) (fdfind)"
        else
            echo "[INFO] $tool already installed"
        fi
        continue
    fi
    if command -v "$tool" &> /dev/null; then
        echo "[INFO] $tool already installed: $(command -v "$tool")"
        continue
    fi

    if [[ -z "$pkg" ]]; then
        echo "[INFO] Skipping $tool (no package for ${PLATFORM}/${PACKAGE_MANAGER})"
        SKIPPED=$((SKIPPED + 1))
        continue
    fi

    echo "[INFO] Installing $tool ($pkg)..."
    if [[ "$tool" == "fastfetch" ]] && [[ "$PLATFORM" == "linux" ]] && [[ "$PACKAGE_MANAGER" == "apt" ]]; then
        if install_fastfetch_apt; then
            echo "[SUCCESS] $tool installed"
            INSTALLED=$((INSTALLED + 1))
        else
            echo "[WARNING] $tool install failed (try PPA / snap / GitHub .deb later)"
            FAILED=$((FAILED + 1))
        fi
    elif install_common_tool_with_fallback "$tool" "$pkg"; then
        echo "[SUCCESS] $tool installed"
        INSTALLED=$((INSTALLED + 1))
    else
        echo "[WARNING] $tool install failed"
        FAILED=$((FAILED + 1))
    fi
done

echo "[INFO] Done: $INSTALLED installed, $FAILED failed, $SKIPPED skipped"
{{- end -}}
