# Git 全局配置（由 chezmoi 管理）
# git_user_* 默认见 .chezmoidata.toml；可在 ~/.config/chezmoi/chezmoi.toml [data] 覆盖
# WSL 下 127.0.0.1 指本机无法访问宿主机代理，若 GitHub clone 失败请在 data 中设置 proxy 为宿主机地址，或 apply 后执行: git config --global --unset http.https://github.com.proxy

[user]
	name = {{ .git_user_name | default "xiaolitongxue666" }}
	email = {{ .git_user_email | default "leonpa1987@gmail.com" }}

[core]
	autocrlf = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
{{- if eq .chezmoi.os "windows" }}
	longpaths = true
	ignorecase = false
{{- end }}

[diff]
	submodule = log

[status]
	submodulesummary = 1

[http]
	sslVerify = true
	postBuffer = 524288000
	lowSpeedLimit = 0
	lowSpeedTime = 999999

[http "https://github.com"]
	proxy = {{ or (env "http_proxy") .proxy "http://127.0.0.1:7890" }}

[https "https://github.com"]
	proxy = {{ or (env "http_proxy") .proxy "http://127.0.0.1:7890" }}
