# ============================================
# SSH 终端 TERM（Pi / TUI / ncurses）
# ============================================
# Cursor/VS Code 集成终端 SSH 时，客户端 SetEnv TERM 需 sshd AcceptEnv TERM（默认仅 LANG/LC_*），
# 常出现 TERM 为空或 xterm-kitty 而远端无对应 terminfo。Pi 依赖 Kitty keyboard protocol，
# 在 SSH 上协商失败会导致按键无响应；统一回退 xterm-256color（VPS 普遍有 terminfo）。
if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] || [[ -z "${TERM:-}" ]]; then
    export TERM=xterm-256color
fi

# Pi / TUI：SSH 会话终端修复（Cursor 集成终端 → VPS）
# TERM  alone 不够：Pi 仍会 query Kitty keyboard protocol；Cursor 1.109+ 会应答，经 SSH 转发后 Esc/修饰键易失效。
# /exit 是发给 AI 的 slash 命令，不是退出；退出用 Ctrl+D / Ctrl+C。
_pi_terminal_cleanup() {
    stty sane 2>/dev/null || true
    printf '\033[?25h\033[?1049l\033[?2004l\033[<u\033[>4;0m' 2>/dev/null || true
}

pi() {
    if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] || [[ -z "${TERM:-}" ]]; then
        export TERM=xterm-256color
    fi
    if [[ -n "${SSH_CONNECTION:-}" && -z "${PI_SSH_HINT_DONE:-}" ]]; then
        export PI_SSH_HINT_DONE=1
        echo "pi/SSH: 退出 /quit 或 /exit 或 Ctrl+D · Esc 中断 · 勿把 /exit 当普通聊天" >&2
    fi
    trap '_pi_terminal_cleanup' EXIT INT TERM HUP
    _pi_terminal_cleanup
    local rc=0
    TERM=xterm-256color command pi "$@" || rc=$?
    _pi_terminal_cleanup
    trap - EXIT INT TERM HUP
    return "$rc"
}

pi-reset() {
    _pi_terminal_cleanup
    command reset
}

# ============================================
# 字符编码设置（确保中文正确显示）
# ============================================
{{ if eq .chezmoi.os "windows" }}
# Windows Git Bash 环境
export LANG=zh_CN.UTF-8
export LC_ALL=zh_CN.UTF-8
export LC_CTYPE=zh_CN.UTF-8
export TERM=xterm-256color
{{ end }}

# ============================================
# 加载 .zshrc（交互式 shell 配置）
# ============================================
# 让 login shell 也读取 .zshrc（防止漏掉极少数只在 interactive 才需要的变量）
[ -f ~/.zshrc ] && source ~/.zshrc

{{- end -}}

