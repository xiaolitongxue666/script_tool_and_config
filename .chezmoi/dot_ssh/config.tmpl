{{- $ssh_dir := joinPath .chezmoi.homeDir ".ssh" }}
{{- if stat (joinPath $ssh_dir "id_ed25519_desktop-win-2026-10-Tg") }}
    IdentityFile ~/.ssh/id_ed25519_desktop-win-2026-10-Tg
{{- else if stat (joinPath $ssh_dir "id_ed25519_mac-mini-2026-10-GY") }}
