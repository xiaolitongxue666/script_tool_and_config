# --- Mac mini（Tailscale 名 mac-mini）---
# 这把密钥只登录 Mac 上的 liyong，不用于 GitHub 或 VPS
Host mac-mini
    HostName mac-mini
    User liyong
    Port 22
{{- $ssh_dir := joinPath .chezmoi.homeDir ".ssh" }}
{{- if stat (joinPath $ssh_dir "id_ed25519_desktop-win-2026-10-A8") }}
    IdentityFile ~/.ssh/id_ed25519_desktop-win-2026-10-A8
{{- end }}
    IdentitiesOnly yes

# --- desktop-win（MagicDNS 显示名仍是 company-pc-win10）---
# Mac 登录密钥只在本机存在时写入。Windows 上没有这把文件，不会写出 IdentityFile
# 服务端默认 shell 已是 D:\Program Files\Git\usr\bin\bash.exe（HKLM\SOFTWARE\OpenSSH
# DefaultShell，命令选项 -lc）。直接 ssh desktop-win 即进 Git Bash。
# 不要在客户端写 RemoteCommand：有远程命令时会报 Cannot execute command-line and remote command。
Host desktop-win
    HostName company-pc-win10
    User Administrator
    Port 22
{{- $ssh_dir := joinPath .chezmoi.homeDir ".ssh" }}
{{- if stat (joinPath $ssh_dir "id_ed25519_mac-mini-2026-10-GY") }}
    IdentityFile ~/.ssh/id_ed25519_mac-mini-2026-10-GY
{{- end }}
    IdentitiesOnly yes

# 其他 Host（如内网 Git 服务器）请在本机或 lazyssh 中单独添加
# --- 其他 Host 默认 ---
Host *
    ForwardAgent yes
    SetEnv TERM=xterm-256color
