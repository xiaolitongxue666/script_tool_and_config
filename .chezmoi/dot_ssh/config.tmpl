    HostName phone-personal-android
    User u0_a0
    Port 8022
{{- $ssh_dir := joinPath .chezmoi.homeDir ".ssh" }}
{{- if stat (joinPath $ssh_dir "id_ed25519_desktop-win-2026-10-6c") }}
    IdentityFile ~/.ssh/id_ed25519_desktop-win-2026-10-6c
{{- else if stat (joinPath $ssh_dir "id_ed25519_mac-mini-2026-10-GY") }}
    IdentityFile ~/.ssh/id_ed25519_mac-mini-2026-10-GY
{{- end }}
    IdentitiesOnly yes

# --- 平板 Termux（Tailscale 名 personal-pad-android，端口 8022）---
# 这把密钥只登录平板，不用于 GitHub 或 VPS
Host personal-pad-android
