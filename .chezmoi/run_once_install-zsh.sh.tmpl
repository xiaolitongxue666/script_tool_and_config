{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") (eq .chezmoi.os "windows") -}}
#!/bin/bash

# ============================================
# Zsh 安装脚本（chezmoi run_once_）
# Oh My Zsh / 插件：.chezmoiexternal.toml.tmpl（仅 linux/darwin）
# 本脚本：zsh 二进制 + 默认 shell
# ============================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${CHEZMOI_PROJECT_ROOT:-$(cd "${SCRIPT_DIR}/../.." && pwd 2>/dev/null || echo "$HOME")}"
COMMON_INSTALL="${PROJECT_ROOT}/scripts/chezmoi/common_install.sh"
if [ ! -f "$COMMON_INSTALL" ]; then
    COMMON_INSTALL="$HOME/.local/share/chezmoi/scripts/chezmoi/common_install.sh"
fi
if [ -f "$COMMON_INSTALL" ]; then
    # shellcheck disable=SC1090
    source "$COMMON_INSTALL"
else
    echo "[ERROR] common_install.sh not found" >&2
    exit 1
fi

export PROXY="${PROXY:-{{ env "http_proxy" | default "http://127.0.0.1:7890" }}}"
load_run_once_context "$SCRIPT_DIR" "install-zsh" || exit 1

if command -v zsh &> /dev/null; then
    echo "[INFO] Zsh already installed: $(zsh --version)"
else
    echo "[INFO] Installing Zsh..."
    case "$PLATFORM" in
        darwin|macos)
            if [[ "$PACKAGE_MANAGER" == "brew" ]]; then
                install_package "zsh"
            else
                echo "[INFO] macOS usually ships with Zsh"
            fi
            ;;
        linux)
            install_package "zsh"
            ;;
        windows)
            if [[ "$PACKAGE_MANAGER" == "pacman" ]]; then
                echo "[INFO] Installing Zsh via MSYS2..."
                install_package "zsh"
            else
                echo "[INFO] On Windows, Zsh is provided by Git for Windows; skipping extra install"
            fi
            ;;
        *)
            echo "[ERROR] Unsupported operating system"
            exit 1
            ;;
    esac
fi

if [[ "$PLATFORM" == "windows" ]]; then
    echo "[INFO] Oh My Zsh via .chezmoiexternal.toml.tmpl on linux/darwin only; skipped on Windows"
fi

if [[ "$PLATFORM" == "linux" || "$PLATFORM" == "darwin" || "$PLATFORM" == "macos" ]]; then
    if command -v zsh &>/dev/null; then
        ZSH_PATH="$(command -v zsh)"
        CURRENT_SHELL=""
        if command -v getent &>/dev/null; then
            CURRENT_SHELL="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f7)"
        elif [[ -f /etc/passwd ]]; then
            CURRENT_SHELL="$(awk -F: -v u="$(id -un)" '$1==u {print $7}' /etc/passwd)"
        fi
        if [[ -n "$ZSH_PATH" && "$CURRENT_SHELL" != "$ZSH_PATH" ]]; then
            if chsh -s "$ZSH_PATH" 2>/dev/null; then
                echo "[SUCCESS] Default shell set to zsh; re-login to take effect"
            else
                echo "[INFO] Could not set default shell automatically. Run: chsh -s $ZSH_PATH"
            fi
        fi
    fi
fi

echo "[SUCCESS] Zsh install step complete (OMZ/plugins via chezmoi externals on linux/darwin)"
{{- end -}}
